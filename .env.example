# Staging profiles
#
# staging-a = https://dev.helloalex.ai  (marketing)
# staging-b = set BASE_URL in envs/staging-b.env
# app-staging = https://dev-app.helloalex.ai (client app)
#
# Optional local override:
# BASE_URL=https://dev.helloalex.ai

QA_ENV=staging-a
BASE_URL=https://dev.helloalex.ai

# Client app auth (required for: npm run test:app)
# QA_APP_EMAIL=you@example.com
# QA_APP_PASSWORD=replace-me

# ALLOW_PROD=1
# ALLOW_APP_ALT=1

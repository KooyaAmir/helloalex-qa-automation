# Staging profiles
#
# app-staging = https://dev-app.helloalex.ai (client app — npm test default)
# staging-a   = https://dev.helloalex.ai     (optional marketing)
# staging-b   = set BASE_URL in envs/staging-b.env
#
# npm test / npm run test:app always use QA_ENV=app-staging via scripts/run-env.cjs.
# Do not point BASE_URL at helloalex.ai or app.helloalex.ai.

QA_ENV=app-staging
BASE_URL=https://dev-app.helloalex.ai

# Client app auth (required for: npm run test:app)
# QA_APP_EMAIL=you@example.com
# QA_APP_PASSWORD=replace-me

# Never set ALLOW_PROD=1 — this program is staging-only.
# ALLOW_APP_ALT=1 is only for an intentional alternate *staging* app host.
